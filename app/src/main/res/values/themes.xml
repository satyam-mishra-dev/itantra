<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ITantra" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_surface</item>
        <item name="android:colorAccent">@color/hero</item>
        <item name="android:colorPrimary">@color/hero</item>
        <item name="android:colorControlActivated">@color/hero</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/inkMuted</item>
        <item name="android:statusBarColor">@color/heroDeep</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textViewStyle">@style/ITantra.TextView</item>
        <item name="android:buttonStyle">@style/ITantra.Button</item>
        <item name="android:editTextStyle">@style/ITantra.EditText</item>
        <item name="android:alertDialogTheme">@style/ITantra.Dialog</item>
    </style>
    <style name="Theme.ITantra.Hero">
        <item name="android:navigationBarColor">@color/heroDeep</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="ITantra.TextView" parent="android:Widget.Material.TextView">
        <item name="android:fontFamily">@font/outfit</item>
    </style>
    <style name="ITantra.Button" parent="android:Widget.Material.Button">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="ITantra.EditText" parent="android:Widget.Material.EditText">
        <item name="android:fontFamily">@font/outfit</item>
    </style>
    <style name="ITantra.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/hero</item>
        <item name="android:fontFamily">@font/outfit</item>
    </style>
</resources>
