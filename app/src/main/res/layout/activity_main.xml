<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- header band -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero_band"
        android:elevation="8dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="24sp"
                android:textColor="@color/onHero"
                android:fontFamily="@font/outfit_bold" />
            <Spinner
                android:id="@+id/lang"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="120dp"
                android:background="@drawable/pill_white"
                android:elevation="4dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxWidth="320dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:background="@drawable/hero_chip"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/starting"
            android:textSize="13sp"
            android:textColor="@color/onHero"
            android:fontFamily="@font/outfit_semibold" />

        <TextView
            android:id="@+id/stats"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:textColor="@color/onHeroMuted"
            android:fontFamily="@font/outfit_medium" />
    </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">
        <LinearLayout
            android:id="@+id/transcriptBox"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/emptyHint"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:padding="24dp">
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/tile_bg"
                    android:padding="16dp"
                    android:src="@drawable/ic_radio"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/empty_state"
                    android:textSize="18sp"
                    android:textColor="@color/ink"
                    android:fontFamily="@font/outfit_semibold" />
                <TextView
                    android:id="@+id/emptySub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/empty_state_sub"
                    android:textSize="14sp"
                    android:textColor="@color/inkMuted" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- bottom sheet: controls + the hero action -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sheet_bg"
        android:elevation="14dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/download"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/pill_soft"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/heroDeepText"
            android:textSize="13sp"
            android:fontFamily="@font/outfit_semibold" />

        <EditText
            android:id="@+id/input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/input_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:hint="@string/input_hint"
            android:textSize="16sp"
            android:textColor="@color/ink"
            android:textColorHint="@color/label"
            android:inputType="text"
            android:imeOptions="actionDone" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/alert"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/pill_red_toggle"
                android:text="@string/alert_pill"
                android:textColor="@color/alert"
                android:textSize="13sp"
                android:letterSpacing="0.1"
                android:fontFamily="@font/outfit_bold" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <FrameLayout
                android:id="@+id/settings"
                style="@style/IconTile"
                android:layout_marginEnd="10dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@string/settings_title" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/connectIp"
                style="@style/IconTile"
                android:layout_marginEnd="10dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_link"
                    android:contentDescription="@string/connect_button" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/eval"
                style="@style/IconTile">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_assess"
                    android:contentDescription="@string/eval_button" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="2dp">
            <View
                android:id="@+id/pttRing"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/ptt_ring" />
            <Button
                android:id="@+id/ptt"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:background="@drawable/ptt_button"
                android:stateListAnimator="@null"
                android:text="@string/ptt_label"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:lineSpacingMultiplier="1.05"
                android:letterSpacing="0.06"
                android:fontFamily="@font/outfit_bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/pttHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/ptt_hint"
            android:textSize="12sp"
            android:textColor="@color/inkMuted" />
    </LinearLayout>
</LinearLayout>
