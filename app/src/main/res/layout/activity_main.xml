<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- hero header band -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero_band"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp"
        android:elevation="6dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="26sp"
                android:textColor="@color/onHero"
                android:fontFamily="@font/outfit_bold" />
            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="210dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:background="@drawable/hero_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="@string/starting"
                android:textSize="13sp"
                android:textColor="@color/onHeroMuted"
                android:fontFamily="@font/outfit_medium" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tagline"
            android:textSize="13sp"
            android:textColor="@color/onHeroMuted" />

        <Spinner
            android:id="@+id/lang"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/pill_white"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp">
        <LinearLayout
            android:id="@+id/transcriptBox"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/emptyHint"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:gravity="center"
                android:padding="24dp">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/tile_bg"
                    android:padding="14dp"
                    android:src="@drawable/ic_wifi"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/empty_state"
                    android:textSize="17sp"
                    android:textColor="@color/textPrimary"
                    android:fontFamily="@font/outfit_semibold" />
                <TextView
                    android:id="@+id/emptySub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/empty_state_sub"
                    android:textSize="14sp"
                    android:textColor="@color/textSecondary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- bottom control panel -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/download"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/pill_button"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/onHero"
            android:textSize="15sp"
            android:fontFamily="@font/outfit_semibold" />

        <EditText
            android:id="@+id/input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/card_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:hint="@string/input_hint"
            android:textSize="16sp"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textSecondary"
            android:inputType="text"
            android:imeOptions="actionDone" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/alert"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="@drawable/pill_red_toggle"
                android:text="@string/alert_pill"
                android:textColor="@color/red"
                android:textSize="13sp"
                android:letterSpacing="0.08"
                android:fontFamily="@font/outfit_bold" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <FrameLayout
                android:id="@+id/connectIp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/tile_bg">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_link"
                    android:contentDescription="@string/connect_button" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/eval"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tile_bg">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_assess"
                    android:contentDescription="@string/eval_button" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="236dp"
            android:layout_marginTop="2dp">
            <View
                android:id="@+id/pttRing"
                android:layout_width="236dp"
                android:layout_height="236dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/ptt_ring" />
            <Button
                android:id="@+id/ptt"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:background="@drawable/ptt_button"
                android:elevation="10dp"
                android:stateListAnimator="@null"
                android:text="@string/ptt_label"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:letterSpacing="0.04"
                android:fontFamily="@font/outfit_bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/pttHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/ptt_hint"
            android:textSize="12sp"
            android:textColor="@color/textSecondary" />
    </LinearLayout>
</LinearLayout>
