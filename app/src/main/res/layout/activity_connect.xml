<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hero">

    <View
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_gravity="top|end"
        android:translationX="140dp"
        android:translationY="-120dp"
        android:background="@drawable/circle_translucent" />
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="bottom|start"
        android:translationX="-150dp"
        android:translationY="60dp"
        android:background="@drawable/circle_translucent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <!-- wordmark: the mark (voice wave → one dot) + name + brand line -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_mark"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textColor="@color/onHero"
                android:textSize="26sp"
                android:letterSpacing="-0.02"
                android:fontFamily="@font/outfit_bold" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tagline"
            android:textColor="@color/signal"
            android:textSize="13sp"
            android:letterSpacing="0.06"
            android:fontFamily="@font/outfit_semibold" />

        <!-- hero stage: a stack of message cards; the front one carries the 45 B claim -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="236dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="-8dp"
                android:alpha="0.6"
                android:src="@drawable/illustration_hero"
                android:contentDescription="@null" />

            <View
                android:layout_width="250dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:translationX="26dp"
                android:translationY="-26dp"
                android:rotation="9"
                android:background="@drawable/hero_chip" />
            <View
                android:layout_width="262dp"
                android:layout_height="146dp"
                android:layout_gravity="center"
                android:translationX="-16dp"
                android:translationY="16dp"
                android:rotation="-7"
                android:background="@drawable/hero_chip" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="270dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:rotation="-3"
                android:elevation="18dp"
                android:background="@drawable/card_bg"
                android:padding="20dp">
                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_wave"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/hero_sample"
                    android:textColor="@color/ink"
                    android:textSize="19sp"
                    android:lineSpacingMultiplier="1.15"
                    android:fontFamily="@font/outfit_semibold" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hero_sample_meta"
                        android:textColor="@color/inkMuted"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit_medium" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/chip_signal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="@string/hero_bytes"
                        android:textColor="@color/onSignal"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit_bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/entry_headline"
            android:textColor="@color/onHero"
            android:textSize="36sp"
            android:lineSpacingMultiplier="0.96"
            android:fontFamily="@font/outfit_bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/entry_sub"
            android:textColor="@color/onHeroMuted"
            android:textSize="16sp" />

        <TextView
            style="@style/Micro"
            android:layout_marginTop="24dp"
            android:text="@string/entry_speak_in"
            android:textColor="@color/onHeroMuted" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="-24dp"
            android:layout_marginEnd="-24dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:scrollbars="none"
            android:clipToPadding="false">
            <LinearLayout
                android:id="@+id/langRow"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/findPeers"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/pill_white"
            android:stateListAnimator="@null"
            android:elevation="10dp"
            android:text="@string/find_peers"
            android:textColor="@color/heroDeep"
            android:textSize="17sp"
            android:fontFamily="@font/outfit_bold"
            android:drawableStart="@drawable/ic_wifi"
            android:drawableTint="@color/heroDeep"
            android:drawablePadding="-24dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />

        <TextView
            android:id="@+id/connectIpLink"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/connect_ip_link"
            android:textColor="@color/onHero"
            android:textSize="15sp"
            android:fontFamily="@font/outfit_semibold"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/scroll_hint"
            android:textColor="@color/onHeroMuted"
            android:textSize="13sp"
            android:fontFamily="@font/outfit_medium" />

        <!-- the five-second pitch: walkie-talkie vs iTantra -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:elevation="10dp"
            android:padding="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cmp_title"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:fontFamily="@font/outfit_bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/cmp_sub"
                android:textColor="@color/inkMuted"
                android:textSize="13sp" />
            <LinearLayout style="@style/CmpRow" android:layout_marginTop="16dp">
                <TextView style="@style/CmpHead" android:text="@string/cmp_walkie" />
                <TextView style="@style/CmpHead" android:text="@string/cmp_itantra" android:textColor="@color/signalDeep" />
            </LinearLayout>
            <View style="@style/CmpRule" />
            <LinearLayout style="@style/CmpRow">
                <TextView style="@style/CmpOld" android:text="@string/cmp_w1" />
                <TextView style="@style/CmpNew" android:text="@string/cmp_i1" />
            </LinearLayout>
            <View style="@style/CmpRule" />
            <LinearLayout style="@style/CmpRow">
                <TextView style="@style/CmpOld" android:text="@string/cmp_w2" />
                <TextView style="@style/CmpNew" android:text="@string/cmp_i2" />
            </LinearLayout>
            <View style="@style/CmpRule" />
            <LinearLayout style="@style/CmpRow">
                <TextView style="@style/CmpOld" android:text="@string/cmp_w3" />
                <TextView style="@style/CmpNew" android:text="@string/cmp_i3" />
            </LinearLayout>
            <View style="@style/CmpRule" />
            <LinearLayout style="@style/CmpRow">
                <TextView style="@style/CmpOld" android:text="@string/cmp_w4" />
                <TextView style="@style/CmpNew" android:text="@string/cmp_i4" />
            </LinearLayout>
            <View style="@style/CmpRule" />
            <LinearLayout style="@style/CmpRow">
                <TextView style="@style/CmpOld" android:text="@string/cmp_w5" />
                <TextView style="@style/CmpNew" android:text="@string/cmp_i5" />
            </LinearLayout>
        </LinearLayout>

        <!-- measured numbers -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="-5dp"
            android:layout_marginEnd="-5dp"
            android:columnCount="2"
            android:useDefaultMargins="true">
            <LinearLayout style="@style/NumCard">
                <TextView style="@style/NumValue" android:text="@string/num_1" />
                <TextView style="@style/NumLabel" android:text="@string/num_1_l" />
            </LinearLayout>
            <LinearLayout style="@style/NumCard">
                <TextView style="@style/NumValue" android:text="@string/num_2" />
                <TextView style="@style/NumLabel" android:text="@string/num_2_l" />
            </LinearLayout>
            <LinearLayout style="@style/NumCard">
                <TextView style="@style/NumValue" android:text="@string/num_3" />
                <TextView style="@style/NumLabel" android:text="@string/num_3_l" />
            </LinearLayout>
            <LinearLayout style="@style/NumCard">
                <TextView style="@style/NumValue" android:text="@string/num_4" />
                <TextView style="@style/NumLabel" android:text="@string/num_4_l" />
            </LinearLayout>
        </GridLayout>

        <TextView
            style="@style/Micro"
            android:layout_width="match_parent"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/brand_kicker"
            android:textColor="@color/onHeroMuted" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
