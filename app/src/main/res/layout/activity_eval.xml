<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">
<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero_band"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="22dp"
        android:elevation="6dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/eval_title"
            android:textSize="28sp"
            android:textColor="@color/onHero"
            android:fontFamily="@font/outfit_bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/eval_subtitle"
            android:textSize="14sp"
            android:textColor="@color/onHeroMuted" />
    </LinearLayout>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

    <TextView style="@style/SectionLabel" android:text="@string/section_rubric" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:useDefaultMargins="true">
        <LinearLayout android:orientation="vertical" android:layout_columnWeight="1" android:layout_width="0dp" android:background="@drawable/card_bg" android:padding="16dp">
            <TextView android:id="@+id/cerVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="30sp" android:textColor="@color/orange" android:fontFamily="@font/outfit_bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_cer" android:textAllCaps="true" android:letterSpacing="0.08" android:textSize="10sp" android:textColor="@color/label" android:fontFamily="@font/outfit_semibold"/>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_columnWeight="1" android:layout_width="0dp" android:background="@drawable/card_bg" android:padding="16dp">
            <TextView android:id="@+id/werVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="30sp" android:textColor="@color/navy" android:fontFamily="@font/outfit_bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_wer" android:textAllCaps="true" android:letterSpacing="0.08" android:textSize="10sp" android:textColor="@color/label" android:fontFamily="@font/outfit_semibold"/>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_columnWeight="1" android:layout_width="0dp" android:background="@drawable/card_bg" android:padding="16dp">
            <TextView android:id="@+id/rtfVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="30sp" android:textColor="@color/navy" android:fontFamily="@font/outfit_bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_rtf" android:textAllCaps="true" android:letterSpacing="0.08" android:textSize="10sp" android:textColor="@color/label" android:fontFamily="@font/outfit_semibold"/>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_columnWeight="1" android:layout_width="0dp" android:background="@drawable/card_bg" android:padding="16dp">
            <TextView android:id="@+id/ttsVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="30sp" android:textColor="@color/navy" android:fontFamily="@font/outfit_bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_tts" android:textAllCaps="true" android:letterSpacing="0.08" android:textSize="10sp" android:textColor="@color/label" android:fontFamily="@font/outfit_semibold"/>
        </LinearLayout>
    </GridLayout>

    <TextView style="@style/SectionLabel" android:text="@string/section_read" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:padding="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/eval_read_this"
            android:textSize="16sp"
            android:textColor="@color/textPrimary"
            android:fontFamily="@font/outfit_semibold" />
        <Spinner
            android:id="@+id/evalLang"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp" />
        <TextView
            android:id="@+id/refSentence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="21sp"
            android:textColor="@color/textPrimary"
            android:paddingTop="8dp"
            android:paddingBottom="14dp" />
        <Button
            android:id="@+id/readPtt"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/pill_button"
            android:stateListAnimator="@null"
            android:text="@string/eval_hold_to_read"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.06"
            android:fontFamily="@font/outfit_bold" />
        <TextView
            android:id="@+id/evalResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="14sp"
            android:textColor="@color/textSecondary" />
    </LinearLayout>

    <TextView style="@style/SectionLabel" android:text="@string/section_packs" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:padding="16dp">
        <LinearLayout
            android:id="@+id/packRows"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/packStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="11sp"
            android:textColor="@color/textSecondary" />
    </LinearLayout>

    <TextView style="@style/SectionLabel" android:text="@string/section_eff" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:padding="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/eval_cpu_title"
            android:textSize="16sp"
            android:textColor="@color/textPrimary"
            android:fontFamily="@font/outfit_semibold" />
        <Button
            android:id="@+id/cpuSample"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/pill_button"
            android:stateListAnimator="@null"
            android:text="@string/eval_cpu_button"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.06"
            android:fontFamily="@font/outfit_bold" />
        <TextView
            android:id="@+id/cpuStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/textPrimary" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
</ScrollView>
