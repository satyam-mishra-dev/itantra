<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/alert" android:endColor="@color/alertDeep" android:type="linear"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/alertSoft"/>
            <stroke android:width="1.5dp" android:color="@color/alert"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
</selector>
